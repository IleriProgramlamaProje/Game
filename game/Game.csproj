<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Resmî 4.7.2 önceden derlenmiş Android şablonu net9.0 ister. -->
    <TargetFramework Condition="'$(GodotTargetPlatform)' == 'android'">net9.0</TargetFramework>
    <!-- Android net9.0 ile C# 13 derler; masaüstü de aynı dil sürümünde kalsın ki
         yalnız C# 14'te olan sözdizimi Android dışa aktarımını sessizce kırmasın. -->
    <LangVersion>13.0</LangVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
</Project>
